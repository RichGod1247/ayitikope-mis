  issuedToName   String?
  issuedToPhone  String?  @db.VarChar(32)
  issuedByUserId String?
  note           String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  reversedAt       DateTime? @db.Timestamptz(6)
  reversedByUserId String?
  reversalReason   String?   @db.Text

  tenant     Tenant     @relation("TenantReceipts", fields: [tenantId], references: [id], onDelete: Cascade)
