  teacher         User             @relation("LessonDeliveryTeacher", fields: [teacherUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lessonNote      LessonNote?      @relation(fields: [lessonNoteId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  curriculumUnit  CurriculumUnit?  @relation(fields: [curriculumUnitId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  assessmentItems AssessmentItem[]

  @@index([tenantId, classroomId, dateTaught], map: "LessonDelivery_tenant_classroom_date_idx")
  @@index([tenantId, term, academicYear], map: "LessonDelivery_tenant_term_year_idx")
  @@index([teacherUserId], map: "LessonDelivery_teacher_idx")
  @@index([lessonNoteId], map: "LessonDelivery_lessonNote_idx")
  @@index([curriculumUnitId], map: "LessonDelivery_curriculumUnit_idx")
  @@index([tenantId, subject, indicatorCode], map: "LessonDelivery_tenant_subject_indicator_idx")
}

model AssessmentScore {
  id        String         @id @default(cuid())
  itemId    String
  studentId String
  score     Float
  comment   String?
  createdAt DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt DateTime       @default(now()) @db.Timestamptz(6)
  item      AssessmentItem @relation(fields: [itemId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([itemId, studentId], name: "assessment_student_unique", map: "assessment_student_unique")
}

model TeacherProfile {
  id                 String       @id @default(cuid())
  tenantId           String
  userId             String
  phone              String
  phase              TeacherPhase
  classLevel         String?
  jhsAssignments     Json?
  additionalDuties   String[]     @default([])
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  primaryClassroomId String?
  primaryClassroom   Classroom?   @relation("TeacherPrimaryClassroom", fields: [primaryClassroomId], references: [id], onUpdate: NoAction)
  tenant             Tenant       @relation("TenantTeacherProfiles", fields: [tenantId], references: [id], onDelete: Cascade)
  user               User         @relation("UserTeacherProfiles", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId], name: "teacherProfile_tenant_user_unique", map: "teacherProfile_tenant_user_unique")
  @@index([tenantId])
  @@index([phase])
  @@index([classLevel])
  @@index([primaryClassroomId])
  @@index([tenantId, primaryClassroomId])
  @@index([tenantId, primaryClassroomId], map: "TeacherProfile_tenant_primaryClassroomId_idx")
}

model Assessment {
  id              String    @id @default(cuid())
  tenantId        String
  classroomId     String
  subject         String
  title           String
  description     String?
  term            String
  academicYear    String
  date            DateTime? @db.Timestamptz(6)
  maxScore        Int
  weight          Int?
  createdByUserId String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @db.Timestamptz(6)
  Classroom       Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  User            User?     @relation(fields: [createdByUserId], references: [id])
  Tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, classroomId, term, academicYear], map: "idx_assessment_tenant_class_term_year")
}

model InviteCode {
  id       String @id @default(cuid())
  tenantId String
  roleId   String

  // store ONLY a hash (never raw code)
  codeHash String  @unique @db.VarChar(128)
  codeHint String? @db.VarChar(16) // e.g. last 4 chars for admin reference

  expiresAt DateTime @db.Timestamptz(6)
  maxUses   Int      @default(1)
  usedCount Int      @default(0)

  revokedAt  DateTime? @db.Timestamptz(6)
  lastUsedAt DateTime? @db.Timestamptz(6)

  createdByUserId String
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdBy User   @relation(fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "InviteCode_createdBy_fkey")

  uses InviteCodeUse[]

  @@index([tenantId, expiresAt], map: "InviteCode_tenant_expires_idx")
  @@index([tenantId, roleId], map: "InviteCode_tenant_role_idx")
  @@index([tenantId, revokedAt], map: "InviteCode_tenant_revoked_idx")
}

model InviteCodeUse {
  id           String   @id @default(cuid())
  inviteCodeId String
  tenantId     String
  userId       String
  usedAt       DateTime @default(now()) @db.Timestamptz(6)
  ip           String?
  userAgent    String?

  inviteCode InviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Cascade)
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([inviteCodeId, userId], map: "InviteCodeUse_invite_user_unique")
  @@index([tenantId, usedAt], map: "InviteCodeUse_tenant_usedAt_idx")
}

/// *
/// * =======================
/// * Sprint 10 — GES Zone Hierarchy & AI Analytics
/// * =======================

// Flexible country-agnostic zone type (Circuit, District, Region, LGA, etc.)
model AdminZoneType {
  id          String      @id @default(cuid())
  countryCode String      // "GH", "NG", "KE" etc.
  level       Int         // 1=lowest (circuit), 2=district, 3=region, 4=national
  name        String      // "Circuit", "District", "Region", "LGA", "County" etc.
  zones       AdminZone[]

  @@unique([countryCode, level], map: "AdminZoneType_country_level_unique")
  @@index([countryCode])
}

model AdminZone {
  id           String        @id @default(cuid())
  name         String
  code         String?
  zoneTypeId   String
  zoneType     AdminZoneType @relation(fields: [zoneTypeId], references: [id])
  parentZoneId String?
  parentZone   AdminZone?    @relation("ZoneHierarchy", fields: [parentZoneId], references: [id])
  childZones   AdminZone[]   @relation("ZoneHierarchy")
  tenants      Tenant[]
  officers     GesOfficer[]

  @@index([zoneTypeId])
  @@index([parentZoneId])
}

model GesOfficer {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id])
  zoneId     String
  zone       AdminZone @relation(fields: [zoneId], references: [id])
  title      String    // "SISO", "District Director", "Regional Director", "Director-General"
  phone      String?
  notifMuted Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([zoneId])
}

// Daily AI briefing snapshots — one per tenant per day
model SchoolRiskSnapshot {
  id                    String   @id @default(cuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  snapshotDate          DateTime @db.Date
  attendanceRate        Float
  assessmentAvg         Float
  lessonNoteRate        Float
  healthFlagCount       Int
  riskScore             Int      // 0-100, higher = more at risk
  riskLevel             String   @default("LOW") // LOW | MEDIUM | HIGH | CRITICAL
  becePassRatePredicted Float?   // null if no JHS3 (BS11) students
  alerts                Json     @default("[]")
  createdAt             DateTime @default(now())

  @@unique([tenantId, snapshotDate], map: "SchoolRiskSnapshot_tenant_date_unique")
  @@index([tenantId, snapshotDate])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum TeacherPhase {
  KG
  PRIMARY
  JHS
}

enum LessonNoteStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum SchemeStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
}

enum TenantStatus {
  PENDING
  ACTIVE
}

enum ClassroomStatus {
  ACTIVE
  ARCHIVED
}

enum StudentStatus {
  ACTIVE
  ARCHIVED
}

enum AssessmentItemStatus {
  DRAFT
  PUBLISHED
  LOCKED
}

enum ScholarshipApplicationStatus {
  PENDING
  REVIEWED
  APPROVED
  REJECTED
}

enum ScholarshipAwardStatus {
  ACTIVE
  REVOKED
}

enum LedgerEntryType {
  INVOICE_DEBIT
  PAYMENT_CREDIT
  ADJUSTMENT_CREDIT
  CORRECTION
}

model ScholarshipApplication {
  id               String                       @id @default(cuid())
  tenantId         String
  studentName      String
  dateOfBirth      DateTime?                    @db.Date
  level            String
  scholarshipType  String
  guardianName     String
  guardianPhone    String
  whatsappNumber   String?
  achievements     String?                      @db.Text
  needStatement    String?                      @db.Text
  status           ScholarshipApplicationStatus @default(PENDING)
  reviewNote       String?                      @db.Text
  reviewedAt       DateTime?                    @db.Timestamptz(6)
  reviewedByUserId String?
  submittedAt      DateTime                     @default(now()) @db.Timestamptz(6)
  createdAt        DateTime                     @default(now()) @db.Timestamptz(6)

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviewedBy User?              @relation("ScholarshipApplicationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  awards     ScholarshipAward[]

  @@index([tenantId, status])
  @@index([tenantId, submittedAt])
}
