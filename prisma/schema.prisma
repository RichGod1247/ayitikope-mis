/// *
/// * =======================
/// * Finance & Trust Spine — Sprint 9 / Phase 1
/// * =======================

model FeeStructure {
  id               String            @id @default(cuid())
  tenantId         String
  name             String
  description      String?
  category         String            @default("GENERAL")
  scope            FeeStructureScope @default(SCHOOL)
  classroomId      String?
  studentId        String?
  term             String
  academicYear     String
  amountPesewas    Int
  isRequired       Boolean           @default(true)
  isRecurring      Boolean           @default(false)
  isActive         Boolean           @default(true)
  approvedByUserId String?
  approvedAt       DateTime?         @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @db.Timestamptz(6)

  tenant       Tenant           @relation("TenantFeeStructures", fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceLines FeeInvoiceLine[]

  @@index([tenantId, term, academicYear])
  @@index([tenantId, scope])
  @@index([tenantId, classroomId])
  @@index([tenantId, studentId])
  @@index([tenantId, isActive])
}

model FeeInvoice {
  id                 String           @id @default(cuid())
  tenantId           String
  studentId          String
  term               String
  academicYear       String
  status             FeeInvoiceStatus @default(OPEN)
  totalBilledPesewas Int              @default(0)
  totalWaivedPesewas Int              @default(0)
  totalPaidPesewas   Int              @default(0)
  balancePesewas     Int              @default(0)
  dueDate            DateTime?        @db.Date
  issuedAt           DateTime         @default(now()) @db.Timestamptz(6)
  closedAt           DateTime?        @db.Timestamptz(6)
  note               String?
  createdAt          DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime         @default(now()) @updatedAt @db.Timestamptz(6)

  student Student @relation("StudentFeeInvoices", fields: [studentId], references: [id], onDelete: Restrict)
  tenant  Tenant  @relation("TenantFeeInvoices", fields: [tenantId], references: [id], onDelete: Cascade)

  lines                    FeeInvoiceLine[]
  payments                 FeePayment[]              @relation("InvoiceFeePayments")
  adjustments              FeeAdjustment[]
  ledgerEntries            LedgerEntry[]
  receipts                 Receipt[]                 @relation("InvoiceReceipts")
  paymentIntents           PaymentIntent[]
  paymentAllocations       PaymentAllocation[]
  reconciliationExceptions ReconciliationException[]

  @@unique([tenantId, studentId, term, academicYear], name: "FeeInvoice_unique_tenant_student_term_year", map: "FeeInvoice_unique_tenant_student_term_year")
  @@index([tenantId, term, academicYear], map: "FeeInvoice_tenant_term_year_idx")
  @@index([tenantId, studentId], map: "FeeInvoice_tenant_student_idx")
  @@index([tenantId, status])
}

model FeeInvoiceLine {
  id             String   @id @default(cuid())
  tenantId       String
  invoiceId      String
  feeStructureId String?
  category       String   @default("GENERAL")
  description    String
  amountPesewas  Int
  waivedPesewas  Int      @default(0)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice      FeeInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure? @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)

  ledgerEntries LedgerEntry[]

  @@unique([tenantId, invoiceId, feeStructureId], map: "FeeInvoiceLine_tenant_invoice_feeStructure_unique")
  @@index([tenantId, invoiceId])
  @@index([tenantId, feeStructureId])
}

model FeePayment {
  id            String @id @default(cuid())
  tenantId      String
  invoiceId     String
  amountPesewas Int

  method String

  reference String?       @db.VarChar(120)
  channel   String?
  status    PaymentStatus @default(SUCCESS)
  paidAt    DateTime      @default(now()) @db.Timestamptz(6)
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  invoice FeeInvoice @relation("InvoiceFeePayments", fields: [invoiceId], references: [id], onDelete: Restrict)
  tenant  Tenant     @relation("TenantFeePayments", fields: [tenantId], references: [id], onDelete: Cascade)

  receipt            Receipt?            @relation("PaymentReceipt")
  ledgerEntries      LedgerEntry[]
  paymentAllocations PaymentAllocation[]
  paymentTransaction PaymentTransaction?
  refunds            FeeRefund[]         @relation("PaymentRefunds")

  /// DB truth: partial unique index manually created:
  /// "FeePayment_tenant_reference_unique"
  /// unique only where reference is not null/blank.
  @@index([tenantId, reference], map: "FeePayment_tenant_reference_idx")
  @@index([tenantId, invoiceId], map: "FeePayment_tenant_invoice_idx")
  @@index([tenantId, paidAt], map: "FeePayment_tenant_paidAt_idx")
  @@index([tenantId, status])
}

model PaymentIntent {
  id                  String              @id @default(cuid())
  tenantId            String
  studentId           String
  invoiceId           String
  settlementAccountId String?
  provider            PaymentProvider     @default(PAYSTACK)
  providerReference   String              @db.VarChar(120)
  amountPesewas       Int
  currency            String              @default("GHS") @db.VarChar(8)
  status              PaymentIntentStatus @default(PENDING)
  checkoutUrl         String?
  accessCode          String?
  metadata            Json                @default("{}")
  expiresAt           DateTime?           @db.Timestamptz(6)
  createdByUserId     String?
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime            @default(now()) @updatedAt @db.Timestamptz(6)

  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student           Student                  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  invoice           FeeInvoice               @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  settlementAccount TenantSettlementAccount? @relation(fields: [settlementAccountId], references: [id], onDelete: SetNull)
  createdBy         User?                    @relation("PaymentIntentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  transactions PaymentTransaction[]

  @@unique([tenantId, provider, providerReference], map: "PaymentIntent_tenant_provider_ref_unique")
  @@index([tenantId, studentId])
  @@index([tenantId, invoiceId])
  @@index([tenantId, status])
  @@index([tenantId, settlementAccountId])
}

model PaymentProviderEvent {
  id                String          @id @default(cuid())
  tenantId          String?
  provider          PaymentProvider @default(PAYSTACK)
  eventType         String
  providerReference String?         @db.VarChar(120)

  eventFingerprint String? @unique @db.VarChar(128)
  providerEventId  String? @db.VarChar(120)

  signature  String?
  rawPayload Json

  eventTime DateTime? @db.Timestamptz(6)

  receivedAt  DateTime  @default(now()) @db.Timestamptz(6)
  firstSeenAt DateTime  @default(now()) @db.Timestamptz(6)
  lastSeenAt  DateTime? @db.Timestamptz(6)
  processedAt DateTime? @db.Timestamptz(6)

  duplicateCount Int     @default(0)
  isReplay       Boolean @default(false)
  isSuspicious   Boolean @default(false)

  suspiciousReason String?
  processingStatus ProviderEventStatus @default(RECEIVED)
  processingError  String?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  /// DB truth: partial unique index manually created:
  /// "PaymentProviderEvent_provider_event_id_unique"
  /// unique only where providerEventId is not null/blank.
  @@index([tenantId])
  @@index([provider, providerReference])
  @@index([provider, eventType, providerReference])
  @@index([provider, eventType, providerEventId], map: "PaymentProviderEvent_provider_event_id_idx")
  @@index([providerEventId])
  @@index([processingStatus])
  @@index([isSuspicious])
  @@index([receivedAt])
  @@index([eventTime])
}

model PaymentTransaction {
  id                    String          @id @default(cuid())
  tenantId              String
  paymentIntentId       String?
  feePaymentId          String?         @unique
  provider              PaymentProvider @default(PAYSTACK)
  providerReference     String          @db.VarChar(120)
  providerTransactionId String?
  amountPesewas         Int
  currency              String          @default("GHS") @db.VarChar(8)
  status                PaymentStatus   @default(SUCCESS)
  channel               String?
  providerPaidAt        DateTime?       @db.Timestamptz(6)
  providerRaw           Json?
  createdByUserId       String?
  createdAt             DateTime        @default(now()) @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentIntent PaymentIntent? @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)
  feePayment    FeePayment?    @relation(fields: [feePaymentId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("PaymentTransactionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  refunds       FeeRefund[]    @relation("TransactionRefunds")

  @@unique([tenantId, provider, providerReference], map: "PaymentTransaction_tenant_provider_ref_unique")
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model TenantSettlementAccount {
  id       String @id @default(cuid())
  tenantId String

  provider PaymentProvider @default(PAYSTACK)

  /// Paystack subaccount code, e.g. ACCT_xxxxx
  providerSubaccountCode String? @db.VarChar(80)

  /// Bank details. Never store full account number in plaintext long-term if avoidable.
  bankCode               String? @db.VarChar(32)
  bankName               String?
  accountName            String?
  accountNumberLast4     String? @db.VarChar(8)
  accountNumberEncrypted String?

  currency String @default("GHS") @db.VarChar(8)

  status SettlementAccountStatus @default(PENDING)

  isPrimary Boolean @default(false)

  /// Compliance/admin approval trail
  requestedByUserId String?
  approvedByUserId  String?
  approvedAt        DateTime? @db.Timestamptz(6)
  disabledAt        DateTime? @db.Timestamptz(6)
  disableReason     String?

  metadata Json @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  requestedBy User? @relation("TenantSettlementRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  approvedBy  User? @relation("TenantSettlementApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  paymentIntents PaymentIntent[]
  payouts        SettlementPayout[]

  @@unique([tenantId, provider, providerSubaccountCode], map: "TenantSettlement_provider_subaccount_unique")
  @@index([tenantId, status])
  @@index([tenantId, isPrimary])
  @@index([provider, providerSubaccountCode])
}

model SettlementPayout {
