generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

/// *
///  * =======================
///  * Core Identity
///  * =======================
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  locale       String?  @default("en")
  timezone     String?  @default("Africa/Accra")
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  smsOptIn     Boolean  @default(true)

  /// ⚠️ LEGACY (do not use for auth going forward).
  /// Staff IDs must be tenant-scoped and live on Membership.staffId(+Norm).
  staffId String?

  firstName String?
  lastName  String?

  // Password lockout
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime? @db.Timestamptz(6)

  // OTP lockout (separate from password lockout)
  failedOtpCount Int       @default(0)
  otpLockedUntil DateTime? @db.Timestamptz(6)

  // 2FA
  twoFactorEnabled             Boolean   @default(false)
  twoFactorSecretCiphertext    String?
  twoFactorSecretKeyCiphertext String?
  twoFactorSecretIv            String?
  twoFactorSecretTag           String?
  twoFactorSetupAt             DateTime? @db.Timestamptz(6)

  // Tenant selection (critical when a user belongs to multiple schools)
  lastActiveTenantId String?
  lastActiveTenant   Tenant? @relation("UserLastActiveTenant", fields: [lastActiveTenantId], references: [id], onDelete: SetNull)

  accounts                 Account[]
  announcementsCreated     Announcement[]        @relation("AnnouncementCreatedBy")
  Assessment               Assessment[]
  assessmentItemsCreated   AssessmentItem[]
  AttendanceSession        AttendanceSession[]
  auditLogs                AuditLog[]
  invitesSent              Invite[]              @relation("UserInvites")
  lessonNotesAsHeadteacher LessonNote[]          @relation("LessonNoteHeadteacher")
  lessonNotesAsTeacher     LessonNote[]          @relation("LessonNoteTeacher")
  memberships              Membership[]
  sessions                 Session[]
  teacherHealthWeekly      TeacherHealthWeekly[]

  // ✅ MULTI-TENANT: user can have multiple teacher profiles (one per tenant)
  teacherProfiles TeacherProfile[] @relation("UserTeacherProfiles")

  // ✅ Scheme of work relations (named; no duplicates)
  schemesAuthored SchemeOfWork[] @relation("SchemeTeacher")
  schemesReviewed SchemeOfWork[] @relation("SchemeReviewedBy")

  @@index([twoFactorEnabled])
  @@index([lastActiveTenantId])
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String?  @default("Africa/Accra")
  locale    String?  @default("en")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ✅ keep your existing DB column named "settings"
  // but avoid naming conflict with the relation.
  settingsJson Json @default("{}") @map("settings")

  announcements       Announcement[]         @relation("TenantAnnouncements")
  Assessment          Assessment[]
  assessmentItems     AssessmentItem[]
  AttendanceSession   AttendanceSession[]
  auditLogs           AuditLog[]
  curriculumUnits     CurriculumUnit[]
  feeInvoices         FeeInvoice[]           @relation("TenantFeeInvoices")
  feePayments         FeePayment[]           @relation("TenantFeePayments")
  feeStructures       FeeStructure[]         @relation("TenantFeeStructures")
  feesInvoices        FeesInvoice[]
  invites             Invite[]
  lessonNotes         LessonNote[]
  memberships         Membership[]
  roles               Role[]
  students            Student[]
  StudentHealthDaily  StudentHealthDaily[]
  teacherHealthWeekly TeacherHealthWeekly[]
  teacherProfiles     TeacherProfile[]       @relation("TenantTeacherProfiles")
  onboardingCodes     TenantOnboardingCode[]

  // ✅ 1–1 strongly typed settings row
  tenantSettings TenantSettings?

  // ✅ REQUIRED opposite relations for Prisma symmetry
  lastActiveUsers User[]         @relation("UserLastActiveTenant")
  classrooms      Classroom[]
  schemes         SchemeOfWork[] @relation("TenantSchemes")
}

/// *
///  * =======================
///  * Tenant Onboarding Codes
///  * =======================
///  * Used for teacher signup when a school gives a rotating code.
///  * Store only a hash of the code (never raw).
model TenantOnboardingCode {
  id        String   @id @default(cuid())
  tenantId  String
  codeHash  String
  active    Boolean  @default(true)
  rotatedAt DateTime @default(now()) @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
  @@index([tenantId])
}

model TenantSettings {
  tenantId            String  @id
  currentTerm         String?
  currentAcademicYear String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  roleId    String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ✅ Tenant-scoped staff identity (BANK-GRADE)
  /// staffId = human format ("AYI-0142")
  /// staffIdNorm = normalized for lookup (uppercase alnum only)
  staffId     String?
  staffIdNorm String?

  role   Role   @relation(fields: [roleId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, tenantId], name: "userId_tenantId")
  /// ✅ Core guarantee: No two people in the same tenant can share a staff ID.
  @@unique([tenantId, staffIdNorm], name: "membership_tenant_staffIdNorm_unique")
  @@index([tenantId, status])
  @@index([userId, status])
}

/// *
///  * =======================
///  * RBAC
///  * =======================
model Role {
  id          String           @id @default(cuid())
  name        String
  description String?
  tenantId    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  invites     Invite[]
  memberships Membership[]
  tenant      Tenant?          @relation(fields: [tenantId], references: [id])
  rolePerms   RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  rolePerms   RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
}

/// *
///  * =======================
///  * Invites
///  * =======================
model Invite {
  id         String    @id @default(cuid())
  tenantId   String
  email      String
  roleId     String
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  invitedBy  String
  createdAt  DateTime  @default(now())
  inviter    User      @relation("UserInvites", fields: [invitedBy], references: [id])
  role       Role      @relation(fields: [roleId], references: [id])
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
}

/// *
///  * =======================
///  * Audit
///  * =======================
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String?
  action     String
  resource   String?
  resourceId String?
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([action])
}

/// *
///  * =======================
///  * NextAuth Adapter
///  * =======================
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// *
///  * =======================
///  * Tenant content
///  * =======================
model Announcement {
  id              String   @id @default(cuid())
  tenantId        String
  title           String   @db.VarChar(160)
  body            String
  createdByUserId String?
  createdAt       DateTime @default(now())
  createdBy       User?    @relation("AnnouncementCreatedBy", fields: [createdByUserId], references: [id])
  tenant          Tenant   @relation("TenantAnnouncements", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

/// *
///  * =======================
///  * Classrooms & Students
///  * =======================
model Classroom {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  tenantId  String
  name      String
  grade     String?
  arm       String?
  capacity  Int?
  note      String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  Assessment         Assessment[]
  assessmentItems    AssessmentItem[]
  AttendanceSession  AttendanceSession[]
  lessonNotes        LessonNote[]
  students           Student[]
  StudentHealthDaily StudentHealthDaily[]

  // ✅ Opposite of SchemeOfWork.classroom
  schemes SchemeOfWork[] @relation("ClassroomSchemes")

  @@unique([tenantId, name, arm], name: "Classroom_tenant_name_arm_unique")
  @@index([tenantId])
  @@index([tenantId, grade])
  @@index([tenantId, name])
}

model Student {
  id               String    @id @default(cuid())
  tenantId         String
  gender           String?
  dateOfBirth      DateTime? @db.Date
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  classroomId      String?
  firstName        String?
  lastName         String?
  sex              String?
  dob              DateTime? @db.Timestamptz(6)
  guardianName     String?
  guardianPhone    String?
  note             String?
  guardianSmsOptIn Boolean   @default(true)
  healthConsentAt  DateTime? @db.Timestamptz(6)

  assessmentScores   AssessmentScore[]
  AttendanceMark     AttendanceMark[]
  feeInvoices        FeeInvoice[]         @relation("StudentFeeInvoices")
  classroom          Classroom?           @relation(fields: [classroomId], references: [id], onUpdate: NoAction)
  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  StudentHealthDaily StudentHealthDaily[]

  @@index([tenantId])
  @@index([classroomId])
}

/// *
///  * =======================
///  * Attendance
///  * =======================
model AttendanceSession {
  id                String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  tenantId          String
  classroomId       String
  date              DateTime  @db.Timestamptz(6)
  takenByUserId     String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  isClosed          Boolean   @default(false)
  closedAt          DateTime? @db.Timestamptz(6)
  certifiedByUserId String?
  certifiedAt       DateTime? @db.Timestamptz(6)
  certifiedNote     String?

  marks     AttendanceMark[]
  classroom Classroom        @relation(fields: [classroomId], references: [id], onUpdate: NoAction, map: "AttendanceSession_classroom_fkey")
  takenBy   User?            @relation(fields: [takenByUserId], references: [id], onUpdate: NoAction, map: "AttendanceSession_takenBy_fkey")
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onUpdate: NoAction, map: "AttendanceSession_tenant_fkey")

  @@unique([tenantId, classroomId, date], map: "AttendanceSession_tenant_classroom_date_unique")
  @@index([date])
  @@index([classroomId], map: "AttendanceSession_classroom_idx")
  @@index([tenantId], map: "AttendanceSession_tenant_idx")
  @@index([tenantId, classroomId, date, isClosed, certifiedAt], map: "attendance_certified_idx")
  @@index([tenantId, classroomId, date, isClosed], map: "attendance_isClosed_idx")
}

model AttendanceMark {
  id        String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  sessionId String
  studentId String
  status    AttendanceStatus
  note      String?
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt DateTime         @default(now()) @updatedAt @db.Timestamptz(6)

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "AttendanceMark_session_fkey")
  student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "AttendanceMark_student_fkey")

  // Keep only ONE
  @@unique([sessionId, studentId], map: "AttendanceMark_sessionId_studentId_unique")
  @@index([studentId], map: "AttendanceMark_student_idx")
}

/// *
///  * =======================
///  * Student Daily Health
///  * =======================
model StudentHealthDaily {
  id             String    @id @default(dbgenerated("gen_random_uuid()"))
  tenantId       String
  classroomId    String
  studentId      String
  date           DateTime  @db.Date
  temperatureC   Decimal?  @db.Decimal(4, 1)
  symptoms       String?
  notes          String?
  sentToParentAt DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  Classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "StudentHealthDaily_classroom_fkey")
  Student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "StudentHealthDaily_student_fkey")
  Tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "StudentHealthDaily_tenant_fkey")

  @@unique([studentId, date], name: "StudentHealthDaily_unique_student_date", map: "StudentHealthDaily_unique_student_date")
  @@index([classroomId, date], map: "StudentHealthDaily_classroom_date_idx")
  @@index([tenantId, date], map: "StudentHealthDaily_tenant_date_idx")
}

/// *
///  * =======================
///  * Teacher Weekly Health
///  * =======================
model TeacherHealthWeekly {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  tenantId    String
  userId      String
  weekStart   DateTime @db.Date
  stressLevel Int
  workload    Int
  comments    String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "TeacherHealthWeekly_tenant_fkey")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "TeacherHealthWeekly_user_fkey")

  // ✅ MUST include tenantId (user can belong to multiple tenants)
  @@unique([tenantId, userId, weekStart], name: "TeacherHealthWeekly_unique_tenant_user_week", map: "TeacherHealthWeekly_unique_tenant_user_week")
  @@index([tenantId, weekStart], map: "idx_thw_tenant_week")
  @@index([userId, weekStart], map: "idx_thw_user_week")
}

/// *
///  * =======================
///  * SMS Auditing
///  * =======================
model SMSSendAudit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String
  toPhone   String
  template  String?
  payload   Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenantId, createdAt], map: "idx_smsaudit_tenant_created")
}

model NotificationContact {
  id            String   @id @default(dbgenerated("gen_random_uuid()"))
  name          String
  phone         String   @unique
  isInitialTest Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
}

model SmsLog {
  id                        BigInt   @id @default(autoincrement())
  createdAt                 DateTime @default(now()) @db.Timestamptz(6)
  to                        String
  from                      String?
  body                      String
  brand                     String?
  tenantId                  String?
  actorId                   String?
  providerMessageId         String?
  providerStatus            Int?
  providerStatusDescription String?
  providerRaw               Json?

  @@map("SmsLog")
}

/// *
///  * =======================
///  * Legacy FeesInvoice (existing)
///  * =======================
model FeesInvoice {
  id             Int       @id @default(autoincrement())
  tenantId       String
  studentId      String?
  studentName    String
  guardianPhone  String
  className      String?
  term           String?
  amountDue      Decimal   @db.Decimal(10, 2)
  dueDate        DateTime? @db.Date
  isPaid         Boolean   @default(false)
  lastReminderAt DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId])
  @@map("FeesInvoice")
}

/// High-level definition of a fee item (e.g. "Term 1 PTA Levy", "Feeding Fee")
model FeeStructure {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  description   String?
  term          String
  academicYear  String
  amountPesewas Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation("TenantFeeStructures", fields: [tenantId], references: [id])
}

/// A bill for one learner for a given term/year
model FeeInvoice {
  id                 String       @id @default(cuid())
  tenantId           String
  studentId          String
  term               String
  academicYear       String
  totalBilledPesewas Int
  totalWaivedPesewas Int          @default(0)
  note               String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  student            Student      @relation("StudentFeeInvoices", fields: [studentId], references: [id])
  tenant             Tenant       @relation("TenantFeeInvoices", fields: [tenantId], references: [id])
  payments           FeePayment[] @relation("InvoiceFeePayments")
}

/// A payment made against a fee invoice
model FeePayment {
  id            String     @id @default(cuid())
  tenantId      String
  invoiceId     String
  amountPesewas Int
  method        String
  reference     String?
  channel       String?
  paidAt        DateTime   @default(now())
  createdAt     DateTime   @default(now())
  invoice       FeeInvoice @relation("InvoiceFeePayments", fields: [invoiceId], references: [id])
  tenant        Tenant     @relation("TenantFeePayments", fields: [tenantId], references: [id])
}

model LessonNote {
  id                        String    @id @default(cuid())
  tenantId                  String
  teacherUserId             String
  headteacherUserId         String?
  classroomId               String?
  weekNumber                Int
  term                      String
  academicYear              String
  subject                   String
  strand                    String
  substrand                 String
  lessonDate                DateTime? @db.Timestamptz(6)
  contentStandard           String?
  indicator                 String?
  lessonTitle               String?
  objectives                String?
  priorKnowledge            String?
  introduction              String?
  lessonDevelopment         String?
  conclusion                String?
  assessment                String?
  homework                  String?
  coreCompetencies          String?
  teachingLearningResources String?
  differentiationNotes      String?
  reflectionNotes           String?
  status                    String    @default("DRAFT")
  headteacherComment        String?
  submittedAt               DateTime? @db.Timestamptz(6)
  reviewedAt                DateTime? @db.Timestamptz(6)
  approvedAt                DateTime? @db.Timestamptz(6)
  rejectedAt                DateTime? @db.Timestamptz(6)
  aiPlanJson                Json?
  aiPlanVersion             Int       @default(1)
  createdAt                 DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  phase                     String?
  level                     String?
  curriculumUnitId          String?

  classroom      Classroom?      @relation(fields: [classroomId], references: [id], onUpdate: NoAction, map: "LessonNote_classroom_fkey")
  curriculumUnit CurriculumUnit? @relation(fields: [curriculumUnitId], references: [id], onUpdate: NoAction)
  headteacher    User?           @relation("LessonNoteHeadteacher", fields: [headteacherUserId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "LessonNote_headteacher_fkey")
  teacher        User            @relation("LessonNoteTeacher", fields: [teacherUserId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "LessonNote_teacher_fkey")
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "LessonNote_tenant_fkey")

  @@index([classroomId], map: "LessonNote_classroom_idx")
  @@index([status])
  @@index([teacherUserId], map: "LessonNote_teacher_idx")
  @@index([tenantId], map: "LessonNote_tenant_idx")
  @@index([term, academicYear, weekNumber], map: "LessonNote_term_year_week_idx")
}

model CurriculumUnit {
  id                  String       @id @default(dbgenerated("gen_random_uuid()"))
  phase               String
  level               String
  subject             String
  term                String
  weekNumber          Int?
  strandCode          String?
  strand              String
  substrandCode       String?
  substrand           String?
  contentStandardCode String?
  contentStandard     String?
  indicatorCode       String?
  indicator           String?
  notes               String?
  createdAt           DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  tenantId            String?
  tenant              Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lessonNotes         LessonNote[]

  @@index([phase, level, subject])
  @@index([strand])
  @@index([subject, term])
}

model CurriculumSubject {
  id                   String             @id @default(cuid())
  phase                String?
  level                String?
  name                 String
  slug                 String             @unique
  description          String?
  orderIndex           Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  tenantId             String?
  curriculumFramework  String             @default("NaCCA Common Core Programme")
  frameworkVersion     String?
  countryCode          String             @default("GH")
  officialSubjectCode  String?
  sourceDocumentUrl    String?
  sourceDocumentTitle  String?
  sourceDocumentYear   Int?
  isGlobal             Boolean            @default(true)
  isActive             Boolean            @default(true)
  lastVerifiedAt       DateTime?
  lastVerifiedByUserId String?
  media                CurriculumMedia[]
  strands              CurriculumStrand[]

  @@index([tenantId])
  @@index([phase, level, name])
  @@index([isActive])
  @@index([countryCode, curriculumFramework], map: "CurriculumSubject_country_framework_idx")
}

model CurriculumStrand {
  id          String                @id @default(cuid())
  subjectId   String
  code        String?
  title       String
  description String?
  orderIndex  Int                   @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  subject     CurriculumSubject     @relation(fields: [subjectId], references: [id])
  subStrands  CurriculumSubStrand[]

  @@index([subjectId])
}

model CurriculumSubStrand {
  id               String                      @id @default(cuid())
  strandId         String
  code             String?
  title            String
  description      String?
  orderIndex       Int                         @default(0)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  contentStandards CurriculumContentStandard[]
  strand           CurriculumStrand            @relation(fields: [strandId], references: [id])

  @@index([strandId])
}

model CurriculumContentStandard {
  id          String                @id @default(cuid())
  subStrandId String
  code        String
  description String
  orderIndex  Int                   @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  subStrand   CurriculumSubStrand   @relation(fields: [subStrandId], references: [id])
  indicators  CurriculumIndicator[]
  media       CurriculumMedia[]

  @@index([subStrandId])
  @@index([code])
}

model CurriculumIndicator {
  id                String                    @id @default(cuid())
  contentStandardId String
  code              String
  description       String
  orderIndex        Int                       @default(0)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @default(now())
  exemplars         CurriculumExemplar[]
  contentStandard   CurriculumContentStandard @relation(fields: [contentStandardId], references: [id])
  media             CurriculumMedia[]

  @@index([contentStandardId])
  @@index([code])
}

model CurriculumExemplar {
  id              String              @id @default(cuid())
  indicatorId     String
  title           String?
  description     String
  assessmentNotes String?
  orderIndex      Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  indicator       CurriculumIndicator @relation(fields: [indicatorId], references: [id])
  media           CurriculumMedia[]

  @@index([indicatorId])
}

model CurriculumMedia {
  id                  String                     @id @default(cuid())
  subjectId           String?
  contentStandardId   String?
  indicatorId         String?
  exemplarId          String?
  pageNumberInPdf     Int
  figureLabel         String?
  imagePath           String
  altText             String
  detailedDescription String
  tags                String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @default(now()) @updatedAt
  contentStandard     CurriculumContentStandard? @relation(fields: [contentStandardId], references: [id])
  exemplar            CurriculumExemplar?        @relation(fields: [exemplarId], references: [id])
  indicator           CurriculumIndicator?       @relation(fields: [indicatorId], references: [id])
  subject             CurriculumSubject?         @relation(fields: [subjectId], references: [id])

  @@unique([indicatorId, imagePath], name: "CurriculumMedia_indicator_image_unique", map: "CurriculumMedia_indicator_image_unique")
  @@index([subjectId])
  @@index([contentStandardId])
  @@index([indicatorId])
  @@index([exemplarId])
}

model ImagePrompt {
  id                  String   @id @default(cuid())
  phase               String
  level               String
  subject             String
  strandCode          String?
  subStrandCode       String?
  contentStandardCode String?
  indicatorCode       String?
  exemplarIndex       Int?
  nodeType            String
  ageBand             String?
  prompt              String
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([subject, strandCode, subStrandCode, contentStandardCode, indicatorCode, exemplarIndex, nodeType], map: "imagePrompt_unique_node")
  @@index([subject])
  @@index([strandCode])
  @@index([subStrandCode])
  @@index([contentStandardCode])
  @@index([indicatorCode])
  @@index([nodeType])
  @@index([phase, level, subject])
}

model SchemeOfWork {
  id            String @id @default(cuid())
  tenantId      String
  teacherUserId String

  // ✅ Subject-aware scheme
  subject     String
  subjectSlug String?

  // ✅ Level/class token (e.g., "B4", "JHS1", "KG2")
  level String

  // Optional link to a specific classroom (if you use Classroom records)
  classroomId String?

  term         String
  academicYear String

  status             SchemeStatus @default(DRAFT)
  submittedAt        DateTime?    @db.Timestamptz(6)
  reviewedAt         DateTime?    @db.Timestamptz(6)
  approvedAt         DateTime?    @db.Timestamptz(6)
  returnedAt         DateTime?    @db.Timestamptz(6)
  headteacherComment String?

  reviewedByUserId String?

  title String?
  notes String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  items SchemeOfWorkItem[]

  teacher   User       @relation("SchemeTeacher", fields: [teacherUserId], references: [id], onDelete: Cascade)
  reviewer  User?      @relation("SchemeReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  tenant    Tenant     @relation("TenantSchemes", fields: [tenantId], references: [id], onDelete: Cascade)
  classroom Classroom? @relation("ClassroomSchemes", fields: [classroomId], references: [id], onDelete: SetNull)

  // ✅ One scheme per teacher per subject per level per term/year
  @@unique([tenantId, teacherUserId, subject, level, term, academicYear], map: "scheme_unique_teacher_subject_level_term_year")
  @@index([tenantId, teacherUserId, term, academicYear], map: "scheme_tenant_teacher_term_year_idx")
  @@index([tenantId, status], map: "scheme_tenant_status_idx")
  @@index([tenantId, subject, level], map: "scheme_tenant_subject_level_idx")
}

model SchemeOfWorkItem {
  id             String @id @default(cuid())
  schemeOfWorkId String

  weekNumber Int

  indicatorId          String?
  indicatorCode        String?
  indicatorDescription String?

  strandTitle                String?
  subStrandTitle             String?
  contentStandardCode        String?
  contentStandardDescription String?

  dayNumber Int?
  notes     String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  scheme SchemeOfWork @relation(fields: [schemeOfWorkId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([schemeOfWorkId, weekNumber], map: "SchemeOfWorkItem_scheme_week_idx")
}

model AssessmentItem {
  id              String            @id @default(cuid())
  tenantId        String
  classroomId     String
  subject         String
  term            String
  academicYear    String
  title           String
  description     String?
  type            String
  maxScore        Int
  weighting       Float?
  date            DateTime?         @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  createdByUserId String?
  classroom       Classroom         @relation(fields: [classroomId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdByUser   User?             @relation(fields: [createdByUserId], references: [id])
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  scores          AssessmentScore[]

  @@index([tenantId, createdByUserId])
}

model AssessmentScore {
  id        String         @id @default(cuid())
  itemId    String
  studentId String
  score     Float
  comment   String?
  createdAt DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt DateTime       @default(now()) @db.Timestamptz(6)
  item      AssessmentItem @relation(fields: [itemId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([itemId, studentId], name: "assessment_student_unique", map: "assessment_student_unique")
}

model TeacherProfile {
  id               String       @id @default(cuid())
  tenantId         String
  userId           String
  phone            String
  phase            TeacherPhase
  classLevel       String?
  jhsAssignments   Json?
  additionalDuties String[]     @default([])
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation("TenantTeacherProfiles", fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("UserTeacherProfiles", fields: [userId], references: [id], onDelete: Cascade)

  // ✅ Bank-grade multi-tenant identity: one teacher profile per user per tenant
  @@unique([tenantId, userId], name: "teacherProfile_tenant_user_unique")
  @@index([tenantId])
  @@index([phase])
  @@index([classLevel])
}

model Assessment {
  id              String    @id @default(cuid())
  tenantId        String
  classroomId     String
  subject         String
  title           String
  description     String?
  term            String
  academicYear    String
  date            DateTime? @db.Timestamptz(6)
  maxScore        Int
  weight          Int?
  createdByUserId String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @db.Timestamptz(6)
  Classroom       Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  User            User?     @relation(fields: [createdByUserId], references: [id])
  Tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, classroomId, term, academicYear], map: "idx_assessment_tenant_class_term_year")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum TeacherPhase {
  KG
  PRIMARY
  JHS
}

enum LessonNoteStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum SchemeStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
}
