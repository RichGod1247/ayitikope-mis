/// *
/// * =======================
/// * Sprint 10 — Governance Geography, Officer Scope & Risk Analytics
/// * =======================
///
/// Bank-grade principle:
/// - Tenant remains the school boundary.
/// - Governance zones provide oversight scope.
/// - Officer assignments determine who may see which schools.
/// - Dashboards must never infer authority from tenant membership alone.

// Flexible country-agnostic zone type.
// Ghana target:
// level 1 = Circuit
// level 2 = District / Municipality
// level 3 = Region
// level 4 = National
model AdminZoneType {
  id          String @id @default(cuid())
  countryCode String // "GH", "NG", "KE" etc.
  level       Int
  name        String // "Circuit", "District", "Region", "National", etc.

  zones AdminZone[]

  @@unique([countryCode, level], map: "AdminZoneType_country_level_unique")
  @@index([countryCode])
}

model AdminZone {
  id          String  @id @default(cuid())
  name        String
  code        String?
  countryCode String  @default("GH")

  zoneTypeId String
  zoneType   AdminZoneType @relation(fields: [zoneTypeId], references: [id], onDelete: Restrict)

  parentZoneId String?
  parentZone   AdminZone?  @relation("ZoneHierarchy", fields: [parentZoneId], references: [id], onDelete: Restrict)
  childZones   AdminZone[] @relation("ZoneHierarchy")

  /// Schools are attached to their lowest practical governance zone.
  /// For Ghana Sprint 10 Phase A, this should be the circuit zone.
  tenants Tenant[]

  /// Legacy placeholder relation. Keep for compatibility, but do not use for new auth.
  officers GesOfficer[]

  /// ✅ Bank-grade officer assignment spine.
  officerAssignments GovernanceOfficerAssignment[]
  officerInvites     GovernanceOfficerInvite[]

  /// ✅ Sprint 10 B.3/B.4 + A16 — governance communication spine
  governanceInterventions     GovernanceInterventionCase[]
  governanceOfficialNotices   GovernanceOfficialNotice[]
  governanceNoticeAttachments GovernanceOfficialNoticeAttachment[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([zoneTypeId])
  @@index([parentZoneId])
  @@index([countryCode])
  @@index([isActive])
  @@index([code])
  @@index([countryCode, code])
}

/// Legacy placeholder retained because the current schema already has it.
/// New Sprint 10 authorization must use GovernanceOfficerAssignment instead.
model GesOfficer {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  zoneId     String
  zone       AdminZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  title      String
  phone      String?
  notifMuted Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([zoneId])
}

model GovernanceOfficerAssignment {
  id String @id @default(cuid())

  userId String
  zoneId String

  role   GovernanceOfficerRole
  status GovernanceAssignmentStatus @default(ACTIVE)

