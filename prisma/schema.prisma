model PaymentIntent {
  id                  String  @id @default(cuid())
  tenantId            String
  studentId           String
  invoiceId           String
  settlementAccountId String?

  /// Who confirms the money.
  /// For Paystack USSD, this remains PAYSTACK.
  provider PaymentProvider @default(PAYSTACK)

  /// How the parent entered/completed the payment.
  /// Examples: "card", "mobile_money", "ussd", "bank_transfer", "checkout".
  /// This prevents the bad design of treating USSD as a provider.
  channel String? @db.VarChar(40)

  providerReference String              @db.VarChar(120)
  amountPesewas     Int
  currency          String              @default("GHS") @db.VarChar(8)
  status            PaymentIntentStatus @default(PENDING)
  checkoutUrl       String?
  accessCode        String?
  metadata          Json                @default("{}")
  expiresAt         DateTime?           @db.Timestamptz(6)
  createdByUserId   String?
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @updatedAt @db.Timestamptz(6)

  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student           Student                  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  invoice           FeeInvoice               @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  settlementAccount TenantSettlementAccount? @relation(fields: [settlementAccountId], references: [id], onDelete: SetNull)
  createdBy         User?                    @relation("PaymentIntentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  transactions PaymentTransaction[]

  @@unique([tenantId, provider, providerReference], map: "PaymentIntent_tenant_provider_ref_unique")
  @@index([tenantId, studentId])
  @@index([tenantId, invoiceId])
  @@index([tenantId, status])
  @@index([tenantId, settlementAccountId])
  @@index([tenantId, provider, channel, status], map: "PaymentIntent_tenant_provider_channel_status_idx")
}

model PaymentProviderEvent {
