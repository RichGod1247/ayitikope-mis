  id String @id @default(cuid())

  tenantId String

  /// Teacher being appraised.
  teacherUserId String

  /// Headteacher/admin who created/conducted the appraisal.
  appraiserUserId String

  /// Set only when finalized.
  finalizedByUserId String?

  classroomId String?

  /// Official form header fields.
  dateObserved DateTime @db.Date
  classTaught  String?  @db.VarChar(80)

  term         String? @db.VarChar(40)
  academicYear String? @db.VarChar(40)

  subject   String? @db.VarChar(120)
  subStrand String? @db.Text

  durationMinutes      Int?
  yearsInService       Int?
  yearsInPresentSchool Int?

  /// Snapshot fields protect finalized reports from later profile/school renames.
  teacherNameSnapshot   String? @db.VarChar(180)
  schoolNameSnapshot    String? @db.VarChar(180)
  circuitSnapshot       String? @db.VarChar(180)
  appraiserNameSnapshot String? @db.VarChar(180)

  /// Evidence links.
  schemeOfWorkId   String?
  lessonNoteId     String?
  lessonDeliveryId String?

  /// Stores assessment item ids/counts and other V1 evidence hints without overbuilding relations.
  evidenceSnapshotJson Json @default("{}")

  status TeacherAppraisalStatus @default(DRAFT)

  /// Section percentages are calculated from TeacherAppraisalScore rows.
  /// N/A rows are excluded from the denominator in API logic.
  preparationPercent             Float?
  lessonDeliveryPercent          Float?
  classroomCulturePercent        Float?
  learnerParticipationPercent    Float?
  understandingStrategiesPercent Float?
  evaluationStrategiesPercent    Float?
  overallPercentage              Float?

  generalComment String? @db.Text

  finalizedAt DateTime? @db.Timestamptz(6)

  metadata Json @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher     User   @relation("TeacherAppraisalTeacher", fields: [teacherUserId], references: [id], onDelete: Cascade)
  appraiser   User   @relation("TeacherAppraisalAppraiser", fields: [appraiserUserId], references: [id], onDelete: Restrict)
  finalizedBy User?  @relation("TeacherAppraisalFinalizedBy", fields: [finalizedByUserId], references: [id], onDelete: SetNull)

  classroom      Classroom?      @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  schemeOfWork   SchemeOfWork?   @relation(fields: [schemeOfWorkId], references: [id], onDelete: SetNull)
  lessonNote     LessonNote?     @relation(fields: [lessonNoteId], references: [id], onDelete: SetNull)
  lessonDelivery LessonDelivery? @relation(fields: [lessonDeliveryId], references: [id], onDelete: SetNull)

  scores TeacherAppraisalScore[]

  @@index([tenantId, status], map: "TeacherAppraisal_tenant_status_idx")
  @@index([tenantId, teacherUserId, status], map: "TeacherAppraisal_tenant_teacher_status_idx")
  @@index([tenantId, appraiserUserId, status], map: "TeacherAppraisal_tenant_appraiser_status_idx")
  @@index([tenantId, dateObserved], map: "TeacherAppraisal_tenant_date_idx")
  @@index([tenantId, classroomId], map: "TeacherAppraisal_tenant_classroom_idx")
  @@index([tenantId, term, academicYear], map: "TeacherAppraisal_tenant_term_year_idx")
  @@index([schemeOfWorkId], map: "TeacherAppraisal_scheme_idx")
  @@index([lessonNoteId], map: "TeacherAppraisal_lessonNote_idx")
  @@index([lessonDeliveryId], map: "TeacherAppraisal_lessonDelivery_idx")
}

model TeacherAppraisalScore {
  id String @id @default(cuid())

  tenantId    String
  appraisalId String

  /// Example: PREPARATION, LESSON_DELIVERY, CLASSROOM_CULTURE
  sectionKey      String @db.VarChar(60)
  sectionTitle    String @db.VarChar(180)
  sectionOrder    Int
  sectionMaxScore Int

  /// Example: 1.1, 1.2, 2.1
  itemKey   String @db.VarChar(20)
