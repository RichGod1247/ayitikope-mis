  @@index([tenantId, createdAt], map: "AttendanceScanEvent_tenant_created_idx")
  @@index([sessionId, createdAt], map: "AttendanceScanEvent_session_created_idx")
  @@index([classroomId, createdAt], map: "AttendanceScanEvent_classroom_created_idx")
  @@index([studentId, createdAt], map: "AttendanceScanEvent_student_created_idx")
  @@index([badgeId], map: "AttendanceScanEvent_badge_idx")
  @@index([status], map: "AttendanceScanEvent_status_idx")
  @@index([scannedByUserId], map: "AttendanceScanEvent_scannedBy_idx")
}

