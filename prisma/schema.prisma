model FinanceOutboxEvent {
  id String @id @default(cuid())

  tenantId String?

  type   FinanceOutboxEventType
  status FinanceOutboxStatus    @default(PENDING)

  idempotencyKey String @db.VarChar(180)

  aggregateType String? @db.VarChar(80)
  aggregateId   String? @db.VarChar(120)

  payload Json @default("{}")

  attempts    Int @default(0)
  maxAttempts Int @default(5)
  priority    Int @default(5)

