  tenantId String?
  zoneId   String?

  scopeType GovernanceInterventionScopeType
  title     String                          @db.VarChar(180)
  summary   String                          @db.Text

  priority GovernanceInterventionPriority @default(MEDIUM)
  status   GovernanceInterventionStatus   @default(OPEN)

  riskScore          Int?
  riskLevel          String? @db.VarChar(40)
  riskSnapshot       Json    @default("{}")
  recommendedActions Json    @default("[]")

  dueAt DateTime? @db.Timestamptz(6)

  createdByUserId   String
  assignedToUserId  String?
  resolvedByUserId  String?
  cancelledByUserId String?

  resolvedAt  DateTime? @db.Timestamptz(6)
  escalatedAt DateTime? @db.Timestamptz(6)
  cancelledAt DateTime? @db.Timestamptz(6)

  resolutionNote     String? @db.Text
  cancellationReason String? @db.Text

  metadata Json @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  tenant Tenant?    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  zone   AdminZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  createdBy   User  @relation("GovernanceInterventionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  assignedTo  User? @relation("GovernanceInterventionAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  resolvedBy  User? @relation("GovernanceInterventionResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  cancelledBy User? @relation("GovernanceInterventionCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)

  events  GovernanceInterventionEvent[]
  notices GovernanceOfficialNotice[]

  @@index([tenantId, status], map: "GovernanceIntervention_tenant_status_idx")
  @@index([zoneId, status], map: "GovernanceIntervention_zone_status_idx")
  @@index([scopeType, status], map: "GovernanceIntervention_scope_status_idx")
  @@index([assignedToUserId, status], map: "GovernanceIntervention_assigned_status_idx")
  @@index([createdByUserId], map: "GovernanceIntervention_createdBy_idx")
  @@index([dueAt], map: "GovernanceIntervention_dueAt_idx")
  @@index([createdAt], map: "GovernanceIntervention_createdAt_idx")
}

model GovernanceInterventionEvent {
