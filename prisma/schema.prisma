  requestedBy User? @relation("FeeRefundRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  approvedBy  User? @relation("FeeRefundApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  ledgerEntries LedgerEntry[]

  @@unique([tenantId, idempotencyKey], map: "FeeRefund_tenant_idempotency_unique")
  @@unique([tenantId, provider, providerRefundReference], map: "FeeRefund_tenant_provider_refund_unique")
  @@index([tenantId, status])
  @@index([tenantId, feePaymentId])
  @@index([tenantId, paymentTransactionId])
  @@index([tenantId, receiptId])
  @@index([provider, providerReference])
  @@index([requestedByUserId])
  @@index([approvedByUserId])
  @@index([cancelledByUserId])
