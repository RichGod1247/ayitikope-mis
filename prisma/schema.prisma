  tenant             Tenant              @relation("TenantFeeRefunds", fields: [tenantId], references: [id], onDelete: Cascade)
  feePayment         FeePayment          @relation("PaymentRefunds", fields: [feePaymentId], references: [id], onDelete: Restrict)
  paymentTransaction PaymentTransaction? @relation("TransactionRefunds", fields: [paymentTransactionId], references: [id], onDelete: SetNull)
