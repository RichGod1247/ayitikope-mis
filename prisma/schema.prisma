generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

/// *
/// * =======================
/// * Core Identity
/// * =======================
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  locale       String?  @default("en")
  timezone     String?  @default("Africa/Accra")
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  smsOptIn     Boolean  @default(true)

  /// ⚠️ LEGACY (do not use for auth going forward).
  /// Staff IDs must be tenant-scoped and live on Membership.staffId(+Norm).
  staffId   String?
  firstName String?
  lastName  String?

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime? @db.Timestamptz(6)

  twoFactorEnabled             Boolean   @default(false)
  twoFactorSecretCiphertext    String?
  twoFactorSecretKeyCiphertext String?
  twoFactorSecretIv            String?
  twoFactorSecretTag           String?
  twoFactorSetupAt             DateTime? @db.Timestamptz(6)

  failedOtpCount Int       @default(0)
  otpLockedUntil DateTime? @db.Timestamptz(6)

  lastActiveTenantId String?

  /// ✅ GLOBAL PHONE IDENTITY
  phone     String?
  phoneNorm String? @unique

  accounts                            Account[]
  announcementsCreated                Announcement[]                @relation("AnnouncementCreatedBy")
  Assessment                          Assessment[]
  assessmentItemsCreated              AssessmentItem[]              @relation("AssessmentItemCreatedBy")
  assessmentItemsPublished            AssessmentItem[]              @relation("AssessmentItemPublishedBy")
  assessmentItemsLocked               AssessmentItem[]              @relation("AssessmentItemLockedBy")
  mockExamSessionsCreated             MockExamSession[]             @relation("MockExamSessionCreatedBy")
  /// ✅ Assessment Sprint A — policy, broadsheet assignment, release governance
  assessmentPoliciesCreated           AssessmentPolicy[]            @relation("AssessmentPolicyCreatedBy")
  teacherAssessmentAssignments        TeacherAssessmentAssignment[] @relation("TeacherAssessmentAssignmentTeacher")
  teacherAssessmentAssignmentsMade    TeacherAssessmentAssignment[] @relation("TeacherAssessmentAssignmentCreatedBy")
  teacherAssessmentAssignmentsRevoked TeacherAssessmentAssignment[] @relation("TeacherAssessmentAssignmentRevokedBy")
  tenantBootstrapInvitesCreated       TenantBootstrapInvite[]       @relation("TenantBootstrapInviteCreatedBy")
  AttendanceSession                   AttendanceSession[]
  attendanceBadgesIssued              StudentAttendanceBadge[]      @relation("AttendanceBadgeIssuedBy")
  attendanceBadgesRevoked             StudentAttendanceBadge[]      @relation("AttendanceBadgeRevokedBy")
  attendanceScans                     AttendanceScanEvent[]         @relation("AttendanceScanScannedBy")
  auditLogs                           AuditLog[]
  invitesSent                         Invite[]                      @relation("UserInvites")
  lessonNotesAsHeadteacher            LessonNote[]                  @relation("LessonNoteHeadteacher")
  lessonNotesAsTeacher                LessonNote[]                  @relation("LessonNoteTeacher")
  lessonDeliveriesAsTeacher           LessonDelivery[]              @relation("LessonDeliveryTeacher")
  memberships                         Membership[]
  sessions                            Session[]
  teacherHealthWeekly                 TeacherHealthWeekly[]
  teacherAttendanceRecords            TeacherAttendanceRecord[]     @relation("TeacherAttendanceTeacher")
  teacherAttendanceMarked             TeacherAttendanceRecord[]     @relation("TeacherAttendanceMarkedBy")
  teacherAttendanceSessionsOpened     TeacherAttendanceSession[]    @relation("TeacherAttendanceSessionOpenedBy")
  teacherAttendanceSessionsClosed     TeacherAttendanceSession[]    @relation("TeacherAttendanceSessionClosedBy")
  teacherAttendanceSessionsCertified  TeacherAttendanceSession[]    @relation("TeacherAttendanceSessionCertifiedBy")

  /// ✅ A15.4B — teacher appraisal evidence spine
  teacherAppraisalsAsTeacher   TeacherAppraisal[] @relation("TeacherAppraisalTeacher")
  teacherAppraisalsAsAppraiser TeacherAppraisal[] @relation("TeacherAppraisalAppraiser")
  teacherAppraisalsFinalized   TeacherAppraisal[] @relation("TeacherAppraisalFinalizedBy")

  teacherProfiles                     TeacherProfile[]              @relation("UserTeacherProfiles")
  lastActiveTenant                    Tenant?                       @relation("UserLastActiveTenant", fields: [lastActiveTenantId], references: [id], onUpdate: NoAction, map: "User_lastActiveTenant_fkey")
  inviteCodes                         InviteCode[]
  inviteCodeUses                      InviteCodeUse[]
  resultsReleasesCreated              ResultsRelease[]              @relation("ResultsReleaseCreatedBy")
  mockResultsReleasesCreated          MockResultsRelease[]          @relation("MockResultsReleaseCreatedBy")
  mockResultsReleaseNotifyJobsCreated MockResultsReleaseNotifyJob[] @relation("MockResultsReleaseNotifyJobCreatedBy")

  /// ✅ Sprint 9 / Phase 1 — finance, scholarships, receipts, reconciliation
  scholarshipApplicationsReviewed  ScholarshipApplication[]  @relation("ScholarshipApplicationReviewer")
  scholarshipAwardsApproved        ScholarshipAward[]        @relation("ScholarshipAwardApprovedBy")
  feeAdjustmentsCreated            FeeAdjustment[]           @relation("FeeAdjustmentCreatedBy")
  ledgerEntriesCreated             LedgerEntry[]             @relation("LedgerEntryCreatedBy")
  receiptsIssued                   Receipt[]                 @relation("ReceiptIssuedBy")
  paymentIntentsCreated            PaymentIntent[]           @relation("PaymentIntentCreatedBy")
  paymentTransactionsCreated       PaymentTransaction[]      @relation("PaymentTransactionCreatedBy")
  reconciliationBatchesCreated     ReconciliationBatch[]     @relation("ReconciliationBatchCreatedBy")
  reconciliationExceptionsResolved ReconciliationException[] @relation("ReconciliationExceptionResolvedBy")
  settlementAccountsRequested      TenantSettlementAccount[] @relation("TenantSettlementRequestedBy")
  settlementAccountsApproved       TenantSettlementAccount[] @relation("TenantSettlementApprovedBy")
  feeRefundsRequested              FeeRefund[]               @relation("FeeRefundRequestedBy")
  feeRefundsApproved               FeeRefund[]               @relation("FeeRefundApprovedBy")
  receiptsReversed                 Receipt[]                 @relation("ReceiptReversedBy")

  /// ✅ Headteacher signature store
  headteacherSignatures HeadteacherSignature[]

  /// Sprint 10 legacy placeholder — retained because current schema already has GES models.
  gesOfficer GesOfficer?

  /// ✅ Sprint 10 — bank-grade governance officer assignment spine.
  /// A user may hold multiple jurisdiction assignments over time.
  governanceOfficerAssignments        GovernanceOfficerAssignment[] @relation("GovernanceOfficerAssignmentUser")
  governanceOfficerAssignmentsCreated GovernanceOfficerAssignment[] @relation("GovernanceOfficerAssignmentCreatedBy")
  governanceOfficerAssignmentsRevoked GovernanceOfficerAssignment[] @relation("GovernanceOfficerAssignmentRevokedBy")

  /// ✅ Sprint 10 — governance officer invite lifecycle.
  governanceOfficerInvitesCreated  GovernanceOfficerInvite[] @relation("GovernanceOfficerInviteCreatedBy")
  governanceOfficerInvitesAccepted GovernanceOfficerInvite[] @relation("GovernanceOfficerInviteAcceptedBy")
  governanceOfficerInvitesRevoked  GovernanceOfficerInvite[] @relation("GovernanceOfficerInviteRevokedBy")

  /// ✅ Sprint 10 B.3/B.4 + A16 — governance intervention,
  /// official notice, selected-recipient, and attachment spine.
  governanceInterventionsCreated   GovernanceInterventionCase[]        @relation("GovernanceInterventionCreatedBy")
  governanceInterventionsAssigned  GovernanceInterventionCase[]        @relation("GovernanceInterventionAssignedTo")
  governanceInterventionsResolved  GovernanceInterventionCase[]        @relation("GovernanceInterventionResolvedBy")
  governanceInterventionsCancelled GovernanceInterventionCase[]        @relation("GovernanceInterventionCancelledBy")
  governanceInterventionEvents     GovernanceInterventionEvent[]       @relation("GovernanceInterventionEventActor")
  governanceOfficialNoticesSent    GovernanceOfficialNotice[]          @relation("GovernanceOfficialNoticeSender")
  governanceNoticeRecipients       GovernanceOfficialNoticeRecipient[] @relation("GovernanceNoticeRecipientUser")

  governanceNoticeAttachmentsUploaded GovernanceOfficialNoticeAttachment[]       @relation("GovernanceNoticeAttachmentUploader")
  governanceNoticeAttachmentAccesses  GovernanceOfficialNoticeAttachmentAccess[] @relation("GovernanceNoticeAttachmentAccessActor")

  @@index([twoFactorEnabled])
  @@index([lastActiveTenantId])
}

model Tenant {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  timezone     String?      @default("Africa/Accra")
  locale       String?      @default("en")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  settingsJson Json         @default("{}") @map("settings")
  schoolCode   String       @unique
  status       TenantStatus @default(PENDING)
  schoolSector SchoolSector @default(PUBLIC)
  emisCode     String?      @unique
  gpsAddress   String?
  district     String?
  circuit      String?
  region       String?

  /// Sprint 10 placeholder — keep because current schema already has AdminZone.
  zoneId String?
  zone   AdminZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  announcements                Announcement[]                @relation("TenantAnnouncements")
  Assessment                   Assessment[]
  assessmentItems              AssessmentItem[]
  mockExamSessions             MockExamSession[]
  /// ✅ Assessment Sprint A — policy + broadsheet assignment spine
  assessmentPolicies           AssessmentPolicy[]
  teacherAssessmentAssignments TeacherAssessmentAssignment[]
  AttendanceSession            AttendanceSession[]
  studentAttendanceBadges      StudentAttendanceBadge[]
  attendanceScanEvents         AttendanceScanEvent[]
  auditLogs                    AuditLog[]
  curriculumUnits              CurriculumUnit[]

  /// ✅ Existing finance relations
  feeInvoices   FeeInvoice[]   @relation("TenantFeeInvoices")
  feePayments   FeePayment[]   @relation("TenantFeePayments")
  feeStructures FeeStructure[] @relation("TenantFeeStructures")
  feeRefunds    FeeRefund[]    @relation("TenantFeeRefunds")

  invites                   Invite[]
  lessonNotes               LessonNote[]
  lessonDeliveries          LessonDelivery[]
  memberships               Membership[]
  roles                     Role[]
  students                  Student[]
  StudentHealthDaily        StudentHealthDaily[]
  teacherHealthWeekly       TeacherHealthWeekly[]
  teacherAttendanceSessions TeacherAttendanceSession[]
  teacherAttendanceRecords  TeacherAttendanceRecord[]

  /// ✅ A15.4B — teacher appraisal evidence spine
  teacherAppraisals TeacherAppraisal[]

  teacherProfiles              TeacherProfile[]              @relation("TenantTeacherProfiles")
  onboardingCodes              TenantOnboardingCode[]
  lastActiveUsers              User[]                        @relation("UserLastActiveTenant")
  tenantSettings               TenantSettings?
  inviteCodes                  InviteCode[]
  inviteCodeUses               InviteCodeUse[]
  tenantBootstrapInvitesUsed   TenantBootstrapInvite[]       @relation("TenantBootstrapInviteUsedTenant")
  resultsReleases              ResultsRelease[]
  mockResultsReleases          MockResultsRelease[]
  mockResultsReleaseNotifyJobs MockResultsReleaseNotifyJob[]

  /// ✅ Headteacher signature store
  headteacherSignatures HeadteacherSignature[]

  /// ✅ School contact points
  contactEmail     String? @db.VarChar(320)
  contactPhone     String? @db.VarChar(32)
  contactPhoneNorm String? @db.VarChar(16)

  /// ✅ Sprint 9 / Phase 1 — finance truth spine
  feeInvoiceLines          FeeInvoiceLine[]
  paymentIntents           PaymentIntent[]
  paymentProviderEvents    PaymentProviderEvent[]
  paymentTransactions      PaymentTransaction[]
  paymentAllocations       PaymentAllocation[]
  sponsorProfiles          SponsorProfile[]
  scholarshipApplications  ScholarshipApplication[]
  scholarshipAwards        ScholarshipAward[]
  feeAdjustments           FeeAdjustment[]
  ledgerEntries            LedgerEntry[]
  receipts                 Receipt[]                 @relation("TenantReceipts")
  reconciliationBatches    ReconciliationBatch[]
  reconciliationExceptions ReconciliationException[]

  /// ✅ Settlement / payout governance
  settlementAccounts TenantSettlementAccount[]
  settlementPayouts  SettlementPayout[]

  /// ✅ Sprint 9 Phase F — durable retry/outbox spine
  financeOutboxEvents FinanceOutboxEvent[]

  /// Sprint 10 placeholder — keep because current schema already has SchoolRiskSnapshot.
  riskSnapshots SchoolRiskSnapshot[]

  /// ✅ Sprint 10 B.3/B.4 + A16 — governance communication spine
  governanceInterventions     GovernanceInterventionCase[]
  governanceOfficialNotices   GovernanceOfficialNotice[]
  governanceNoticeRecipients  GovernanceOfficialNoticeRecipient[]
  governanceNoticeAttachments GovernanceOfficialNoticeAttachment[]

  @@index([status])
  @@index([schoolSector])
  @@index([schoolCode])
  @@index([contactPhoneNorm])
  @@index([contactEmail])
  @@index([zoneId])
}

/// *
/// * =======================
/// * Tenant Onboarding Codes
/// * =======================
/// * Used for teacher signup when a school gives a rotating code.
/// * Store only a hash of the code (never raw).
model TenantOnboardingCode {
  id        String   @id @default(cuid())
  tenantId  String
  codeHash  String
  active    Boolean  @default(true)
  rotatedAt DateTime @default(now()) @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, active], map: "TenantOnboardingCode_tenant_active_idx")
}

model TenantSettings {
  tenantId  String   @id
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  // term + year (single definition only)
  currentAcademicYear String? @map("current_academic_year")
  currentTerm         String? @map("current_term")

  // term dates
  term1Start DateTime? @map("term1_start") @db.Date
  term1End   DateTime? @map("term1_end") @db.Date
  term2Start DateTime? @map("term2_start") @db.Date
  term2End   DateTime? @map("term2_end") @db.Date
  term3Start DateTime? @map("term3_start") @db.Date
  term3End   DateTime? @map("term3_end") @db.Date

  // attendance settings
  attendanceStartTime String?  @map("attendance_start_time")
  attendanceEndTime   String?  @map("attendance_end_time")
  lateCutoffMinutes   Int?     @map("late_cutoff_minutes")
  feverThreshold      Decimal? @map("fever_threshold") @db.Decimal(4, 1)

  setupCompletedAt DateTime? @map("setup_completed_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "tenant_settings_tenant_fk")

  @@index([updatedAt])
  @@map("tenant_settings")
}

model TenantBootstrapInvite {
  id String @id @default(cuid())

  /// sha256 hex => 64 chars
  tokenHash String @unique @db.VarChar(64)

  // What the school provided
  schoolName       String?
  schoolSector     SchoolSector @default(PUBLIC)
  contactEmail     String
  contactPhone     String?
  contactPhoneNorm String?

  // Reserved identifiers (so you can message SCH-XXXXXX up-front)
  reservedSlug       String
  reservedSchoolCode String @unique

  expiresAt    DateTime  @db.Timestamptz(6)
  usedAt       DateTime? @db.Timestamptz(6)
  usedTenantId String?

  createdByUserId String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  /// ✅ Relations (MUST have opposites on User/Tenant)
  createdByUser User?   @relation("TenantBootstrapInviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  usedTenant    Tenant? @relation("TenantBootstrapInviteUsedTenant", fields: [usedTenantId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@index([usedAt])
  @@index([reservedSlug])
  @@index([contactPhoneNorm])
  @@index([contactEmail])
  @@index([schoolSector])
}

model OnboardingApplication {
  id String @id @default(cuid())

  type   OnboardingApplicationType
  status OnboardingApplicationStatus @default(PENDING)

  applicantName  String?
  applicantTitle String?

  email     String @db.VarChar(320)
  emailNorm String @db.VarChar(320)

  phone     String? @db.VarChar(32)
  phoneNorm String? @db.VarChar(16)

  schoolName     String?
  schoolSector   SchoolSector?
  officialId     String?       @db.VarChar(120)
  officialIdNorm String?       @db.VarChar(120)

  gpsAddress String?
  region     String?
  district   String?
  circuit    String?

  governanceRole GovernanceOfficerRole?
  zoneId         String?
  title          String?

  notes  String? @db.Text
  source String  @default("PUBLIC_APPLICATION") @db.VarChar(80)

  ip        String?
  userAgent String?

  reviewedByUserId String?
  reviewedAt       DateTime? @db.Timestamptz(6)
  reviewReason     String?   @db.Text

  convertedByUserId String?
  convertedAt       DateTime? @db.Timestamptz(6)

  convertedTenantBootstrapInviteId   String?
  convertedGovernanceOfficerInviteId String?

  metadata Json @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([type, status])
  @@index([status, createdAt])
  @@index([emailNorm])
  @@index([phoneNorm])
  @@index([officialIdNorm])
  @@index([zoneId])
  @@index([governanceRole])
  @@index([convertedTenantBootstrapInviteId])
  @@index([convertedGovernanceOfficerInviteId])
}

model HeadteacherSignature {
  id       String @id @default(cuid())
  tenantId String
  userId   String

  signatureSvg  String
  signatureHash String @db.VarChar(64)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId], name: "tenantId_userId", map: "HeadteacherSignature_tenant_user_unique")
  @@index([tenantId], map: "HeadteacherSignature_tenant_idx")
  @@index([userId], map: "HeadteacherSignature_user_idx")
}

model Membership {
  id       String @id @default(cuid())
  userId   String
  tenantId String
  roleId   String

  /// ✅ Membership lifecycle state
  status String @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ✅ Tenant-scoped staff identity (BANK-GRADE)
  /// staffId = human format ("AYI-0142")
  /// staffIdNorm = normalized for lookup (uppercase alnum only)
  staffId     String?
  staffIdNorm String?

  role   Role   @relation(fields: [roleId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  /// ✅ One membership per user per tenant
  @@unique([userId, tenantId], name: "userId_tenantId")
  /// ✅ Bank-grade uniqueness: staff identity cannot collide inside a tenant
  /// Note: Prisma will accept this, but DB is the source of truth via the index you created.
  @@unique([tenantId, staffIdNorm], map: "Membership_tenant_staffIdNorm_unique")
}

/// *
/// * =======================
/// * RBAC
/// * =======================
/// *
/// * =======================
/// * RBAC (TENANT-SCOPED ROLES)
/// * =======================
model Role {
  id          String   @id @default(cuid())
  name        String
  description String?
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invites     Invite[]
  memberships Membership[]
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  rolePerms   RolePermission[]
  inviteCodes InviteCode[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  rolePerms   RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

/// *
/// * =======================
/// * Invites
/// * =======================
model Invite {
  id         String    @id @default(cuid())
  tenantId   String
  email      String
  roleId     String
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  invitedBy  String
  createdAt  DateTime  @default(now())
  inviter    User      @relation("UserInvites", fields: [invitedBy], references: [id])
  role       Role      @relation(fields: [roleId], references: [id])
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
}

/// *
/// * =======================
/// * Audit
/// * =======================
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String?
  action     String
  resource   String?
  resourceId String?
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([action])
}

model ApiRateLimitBucket {
  id           String    @id @default(cuid())
  scope        String    @db.VarChar(100)
  keyHash      String    @db.VarChar(128)
  windowStart  DateTime  @db.Timestamptz(6)
  count        Int       @default(1)
  blockedUntil DateTime? @db.Timestamptz(6)
  metadata     Json      @default("{}")
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  lastSeenAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([scope, keyHash, windowStart], map: "ApiRateLimitBucket_scope_key_window_unique")
  @@index([scope, keyHash])
  @@index([blockedUntil])
  @@index([createdAt])
}

/// *
/// * =======================
/// * NextAuth Adapter
/// * =======================
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// *
/// * =======================
/// * Tenant content
/// * =======================
model Announcement {
  id              String   @id @default(cuid())
  tenantId        String
  title           String   @db.VarChar(160)
  body            String
  createdByUserId String?
  createdAt       DateTime @default(now())
  createdBy       User?    @relation("AnnouncementCreatedBy", fields: [createdByUserId], references: [id])
  tenant          Tenant   @relation("TenantAnnouncements", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

/// *
/// * =======================
/// * Classrooms & Students
/// * =======================
model Classroom {
  id       String @id @default(dbgenerated("gen_random_uuid()"))
  tenantId String

  // Display fields (what UI shows)
  name  String
  grade String?
  arm   String?

  // ✅ Bank-grade uniqueness keys (what DB enforces)
  nameNorm String @default("") @db.VarChar(32)
  armNorm  String @default("") @db.VarChar(8)

  // ✅ Toggle for single-stream schools / cleanup
  status ClassroomStatus @default(ACTIVE)

  capacity  Int?
  note      String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  Assessment           Assessment[]
  assessmentItems      AssessmentItem[]
  mockExamSessions     MockExamSession[]
  AttendanceSession    AttendanceSession[]
  attendanceScanEvents AttendanceScanEvent[]
  lessonNotes          LessonNote[]
  lessonDeliveries     LessonDelivery[]

  /// ✅ A15.4B — teacher appraisal evidence spine
  teacherAppraisals TeacherAppraisal[]

  students                     Student[]
  StudentHealthDaily           StudentHealthDaily[]
  primaryTeachers              TeacherProfile[]              @relation("TeacherPrimaryClassroom")
  resultsReleases              ResultsRelease[]
  mockResultsReleases          MockResultsRelease[]
  mockResultsReleaseNotifyJobs MockResultsReleaseNotifyJob[]
  teacherAssessmentAssignments TeacherAssessmentAssignment[]

  // Legacy unique (optional). Keep it if it still exists in DB.
  // IMPORTANT: do NOT "map" it unless you're 100% sure the DB constraint name matches.
  @@unique([tenantId, name, arm], name: "Classroom_tenant_name_arm_unique")
  // ✅ Real protection against KG1 vs KG 1 vs K.G.1, and B1A typed into name, etc.
  @@unique([tenantId, nameNorm, armNorm], map: "Classroom_tenant_nameNorm_armNorm_unique")
  @@index([tenantId, status], map: "Classroom_tenant_status_idx")
}

model ResultsRelease {
  id String @id @default(cuid())

  tenantId     String @map("tenant_id")
  term         String
  academicYear String @map("academic_year")

  // "SCHOOL" | "CLASSROOM"
  scope String

  // ✅ Uniqueness key:
  // - SCHOOL => "SCHOOL"
  // - CLASSROOM => classroomId
  scopeKey String @map("scope_key") @db.VarChar(64)

  classroomId String? @map("classroom_id")

  /// ✅ Assessment Sprint A — release must be backed by readiness evidence.
  readinessStatus       ResultsReleaseReadinessStatus @default(BLOCKED) @map("readiness_status")
  readinessScore        Int                           @default(0) @map("readiness_score")
