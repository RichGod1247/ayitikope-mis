  @@unique([tenantId, mockExamSessionId, scopeKey], name: "MockResultsRelease_scope_unique", map: "MockResultsRelease_tenant_session_scopeKey_unique")
  @@index([tenantId, academicYear, mockNumber], map: "MockResultsRelease_tenant_year_number_idx")
  @@index([tenantId, classroomId], map: "MockResultsRelease_tenant_classroom_idx")
  @@index([tenantId, mockExamSessionId], map: "MockResultsRelease_tenant_session_idx")
  @@index([tenantId, parentVisible], map: "MockResultsRelease_tenant_parentVisible_idx")
  @@index([tenantId, readinessStatus], map: "MockResultsRelease_tenant_readiness_idx")
  @@index([releasedByUserId], map: "MockResultsRelease_releasedBy_idx")
