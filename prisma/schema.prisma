  @@index([tenantId, status], map: "FinanceOutboxEvent_tenant_status_idx")
  @@index([status, nextAttemptAt, priority], map: "FinanceOutboxEvent_dispatch_idx")
  @@index([aggregateType, aggregateId], map: "FinanceOutboxEvent_aggregate_idx")
}

