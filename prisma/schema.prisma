  mockExamSession MockExamSession @relation(fields: [mockExamSessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  releasedByUser  User            @relation("MockResultsReleaseCreatedBy", fields: [releasedByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)

