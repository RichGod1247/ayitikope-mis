  metadata      Json    @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  settlementAccount TenantSettlementAccount? @relation(fields: [settlementAccountId], references: [id], onDelete: SetNull)

  @@unique([tenantId, provider, providerTransferCode], map: "SettlementPayout_tenant_provider_transfer_unique")
  @@index([tenantId, status])
  @@index([tenantId, settlementAccountId])
  @@index([tenantId, paidAt])
  @@index([provider, providerTransferCode])
  @@index([provider, providerReference])
}

model PaymentAllocation {
