  @@index([curriculumUnitId])
  @@index([lessonDeliveryId], map: "AssessmentItem_lessonDeliveryId_idx")
  @@index([mockExamSessionId], map: "AssessmentItem_mockExamSessionId_idx")
  @@index([assessmentPolicyId], map: "AssessmentItem_policy_idx")
  @@index([policyComponentId], map: "AssessmentItem_policyComponent_idx")
  @@index([tenantId, curriculumUnitId], map: "AssessmentItem_tenant_curriculumUnitId_idx")
  @@index([tenantId, classroomId, term, academicYear], map: "AssessmentItem_filters_idx")
  @@index([tenantId, classroomId, term, academicYear, status], map: "AssessmentItem_filters_status_idx")
  @@index([tenantId, classroomId, subject, term, academicYear, componentCode], map: "AssessmentItem_broadsheet_component_idx")
  @@index([tenantId, classroomId, academicYear, type, mockExamSessionId], map: "AssessmentItem_mock_idx")
}

model MockExamSession {
  id String @id @default(cuid())

  tenantId    String
  classroomId String

  /// Resets every academic year.
  academicYear String

  /// Optional because some schools write mock outside ordinary term structures.
  term String?

  /// 1st Mock, 2nd Mock, 3rd Mock...
  mockNumber Int

  /// Human label displayed in UI.
  mockLabel String @db.VarChar(80)

  /// Example: "2025/2026 BECE Mock 1"
  title String @db.VarChar(180)

  /// OPEN | CLOSED | LOCKED
  status String @default("OPEN") @db.VarChar(40)

  date DateTime? @db.Timestamptz(6)

  createdByUserId String?

  metadata Json @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

