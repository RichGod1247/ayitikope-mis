  revokeReason String?
  metadata     Json    @default("{}")

  user      User      @relation("GovernanceOfficerAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  zone      AdminZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  createdBy User?     @relation("GovernanceOfficerAssignmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  revokedBy User?     @relation("GovernanceOfficerAssignmentRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([zoneId])
  @@index([role])
  @@index([status])
  @@index([userId, status])
  @@index([zoneId, status])
  @@index([userId, zoneId, role, status], map: "GovernanceOfficerAssignment_user_zone_role_status_idx")
}

model GovernanceOfficerInvite {
  id String @id @default(cuid())

  email     String @db.VarChar(320)
  emailNorm String @db.VarChar(320)

  phone     String? @db.VarChar(32)
