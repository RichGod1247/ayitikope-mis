  case  GovernanceInterventionCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor User?                      @relation("GovernanceInterventionEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt], map: "GovernanceInterventionEvent_case_created_idx")
  @@index([actorUserId], map: "GovernanceInterventionEvent_actor_idx")
  @@index([eventType], map: "GovernanceInterventionEvent_type_idx")
}

model GovernanceOfficialNotice {
  id String @id @default(cuid())

  caseId   String?
  tenantId String?
  zoneId   String?

  senderUserId String

  title String @db.VarChar(180)
  body  String @db.Text

  priority GovernanceInterventionPriority @default(MEDIUM)
  status   GovernanceOfficialNoticeStatus @default(QUEUED)

  /// How the sender selected the recipients:
  /// ROLE_SCOPE = role within school/zone
  /// INDIVIDUALS = one or more selected users
  /// SCHOOL_SET = selected schools whose authorized members were resolved
  audienceMode GovernanceOfficialNoticeAudienceMode @default(ROLE_SCOPE)

  /// Example: ["IN_APP", "SMS", "EMAIL"]
  channels Json @default("[]")

  audienceSummary String? @db.Text

  /// Bank-grade duplicate protection.
  /// Normal official intervention notices must reuse the same idempotencyKey.
  /// Reminder/escalation notices must use a different intentional key.
  idempotencyKey   String? @unique(map: "GovernanceOfficialNotice_idempotencyKey_unique") @db.VarChar(220)
  idempotencyScope String? @db.VarChar(80)

  metadata Json @default("{}")

  sentAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  case   GovernanceInterventionCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  tenant Tenant?                     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  zone   AdminZone?                  @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  sender User                        @relation("GovernanceOfficialNoticeSender", fields: [senderUserId], references: [id], onDelete: Restrict)

  recipients         GovernanceOfficialNoticeRecipient[]
  deliveries         GovernanceOfficialNoticeDelivery[]
  attachments        GovernanceOfficialNoticeAttachment[]
  attachmentAccesses GovernanceOfficialNoticeAttachmentAccess[]

  @@index([caseId], map: "GovernanceOfficialNotice_case_idx")
  @@index([tenantId, status], map: "GovernanceOfficialNotice_tenant_status_idx")
  @@index([zoneId, status], map: "GovernanceOfficialNotice_zone_status_idx")
  @@index([senderUserId], map: "GovernanceOfficialNotice_sender_idx")
  @@index([status, createdAt], map: "GovernanceOfficialNotice_status_created_idx")
  @@index([audienceMode, createdAt], map: "GovernanceOfficialNotice_audience_created_idx")
  @@index([caseId, idempotencyScope], map: "GovernanceOfficialNotice_case_idempotencyScope_idx")
  @@index([tenantId, idempotencyScope], map: "GovernanceOfficialNotice_tenant_idempotencyScope_idx")
  @@index([zoneId, idempotencyScope], map: "GovernanceOfficialNotice_zone_idempotencyScope_idx")
}

model GovernanceOfficialNoticeRecipient {
  id String @id @default(cuid())

  noticeId String
  tenantId String?

  recipientUserId String?

  recipientType GovernanceOfficialNoticeRecipientType

  /// Immutable recipient snapshot captured when the notice is sent.
  displayName String? @db.VarChar(160)
  roleLabel   String? @db.VarChar(120)

  phone String? @db.VarChar(32)
  email String? @db.VarChar(320)

  inAppVisible Boolean @default(true)

  readAt          DateTime? @db.Timestamptz(6)
  acknowledgedAt  DateTime? @db.Timestamptz(6)
  acknowledgeNote String?   @db.Text

  respondedAt  DateTime? @db.Timestamptz(6)
  responseBody String?   @db.Text

  metadata Json @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  notice        GovernanceOfficialNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  tenant        Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  recipientUser User?                    @relation("GovernanceNoticeRecipientUser", fields: [recipientUserId], references: [id], onDelete: SetNull)

  deliveries         GovernanceOfficialNoticeDelivery[]
  attachmentAccesses GovernanceOfficialNoticeAttachmentAccess[]

  /// DB truth:
  /// GovernanceNoticeRecipient_notice_user_unique prevents the same
  /// non-null recipientUserId from being inserted twice for one notice.
  @@index([noticeId], map: "GovernanceNoticeRecipient_notice_idx")
  @@index([tenantId], map: "GovernanceNoticeRecipient_tenant_idx")
  @@index([recipientUserId, readAt], map: "GovernanceNoticeRecipient_user_read_idx")
  @@index([recipientType], map: "GovernanceNoticeRecipient_type_idx")
  @@index([createdAt], map: "GovernanceNoticeRecipient_created_idx")
}

model GovernanceOfficialNoticeDelivery {
  id String @id @default(cuid())

  noticeId    String
  recipientId String

  channel GovernanceOfficialNoticeChannel
  status  GovernanceOfficialNoticeDeliveryStatus @default(PENDING)

  toAddress String? @db.VarChar(320)

  provider                  String? @db.VarChar(80)
  providerMessageId         String? @db.VarChar(160)
  providerStatus            Int?
  providerStatusDescription String?
  providerRaw               Json?

  attempts Int @default(0)

  lastError String? @db.Text

  lastAttemptAt DateTime? @db.Timestamptz(6)
  sentAt        DateTime? @db.Timestamptz(6)
  deliveredAt   DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  notice    GovernanceOfficialNotice          @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  recipient GovernanceOfficialNoticeRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([recipientId, channel], map: "GovernanceNoticeDelivery_recipient_channel_unique")
  @@index([noticeId, channel], map: "GovernanceNoticeDelivery_notice_channel_idx")
  @@index([status, channel], map: "GovernanceNoticeDelivery_status_channel_idx")
  @@index([lastAttemptAt], map: "GovernanceNoticeDelivery_lastAttempt_idx")
}

/// A16.3 — private document attachment stored in Cloudflare R2.
///
/// Upload lifecycle:
/// PENDING_UPLOAD → UPLOADED → READY → SEALED
///
/// Only READY attachments may be joined to a notice.
/// Once the notice is sent, the attachment becomes SEALED and immutable.
model GovernanceOfficialNoticeAttachment {
  id String @id @default(cuid())

  /// Null while the file is an unsealed upload draft.
  noticeId String?

  /// At least one scope boundary must exist.
  tenantId String?
  zoneId   String?

  uploadedByUserId String

  originalFilename String @db.VarChar(255)
  displayFilename  String @db.VarChar(255)

  /// Allowed initially:
  /// pdf, doc, docx, ppt, pptx, xls, xlsx
  extension String @db.VarChar(12)
  mimeType  String @db.VarChar(160)
  sizeBytes BigInt

  storageProvider String @default("R2") @db.VarChar(40)

  /// Private R2 object key. Never expose this directly to recipients.
  objectKey String @unique(map: "GovernanceNoticeAttachment_objectKey_unique") @db.VarChar(500)

  etag       String? @db.VarChar(160)
  sha256Hash String? @db.VarChar(64)

  /// Prevents repeated upload initialization after retries or weak networks.
  uploadIdempotencyKey String @db.VarChar(180)

  status GovernanceOfficialNoticeAttachmentStatus @default(PENDING_UPLOAD)

  /// File-signature, container, and active-content inspection.
  /// This does not represent an antivirus or malware-engine verdict.
  scanStatus GovernanceOfficialNoticeAttachmentScanStatus @default(PENDING)

  /// Independent server-side malware-scanner verdict.
  /// Historical attachments and new unscanned uploads remain NOT_SCANNED.
  malwareScanStatus GovernanceOfficialNoticeAttachmentMalwareScanStatus @default(NOT_SCANNED)

  /// Scanner evidence and durable retry state.
  malwareScanEngine        String?   @db.VarChar(120)
  malwareSignatureVersion  String?   @db.VarChar(160)
  malwareScanQueuedAt      DateTime? @db.Timestamptz(6)
  malwareScanStartedAt     DateTime? @db.Timestamptz(6)
  malwareScannedAt         DateTime? @db.Timestamptz(6)
  malwareScanAttempts      Int       @default(0)
  malwareScanNextAttemptAt DateTime? @db.Timestamptz(6)
  malwareScanLastError     String?   @db.Text
  malwareDetectedThreat    String?   @db.VarChar(255)

  /// Confidential files should be accessed only through an authenticated,
  /// short-lived download route—not permanent email or public URLs.
  confidential     Boolean @default(false)
  recipientVisible Boolean @default(true)

  uploadedAt DateTime? @db.Timestamptz(6)
  verifiedAt DateTime? @db.Timestamptz(6)
  sealedAt   DateTime? @db.Timestamptz(6)

  rejectedAt      DateTime? @db.Timestamptz(6)
  rejectionReason String?   @db.Text

  deletedAt DateTime? @db.Timestamptz(6)

  metadata Json @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  notice GovernanceOfficialNotice? @relation(fields: [noticeId], references: [id], onDelete: Restrict)
  tenant Tenant?                   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  zone   AdminZone?                @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  uploadedBy User @relation("GovernanceNoticeAttachmentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  accessEvents GovernanceOfficialNoticeAttachmentAccess[]

  @@unique([uploadedByUserId, uploadIdempotencyKey], map: "GovernanceNoticeAttachment_uploader_idempotency_unique")
  @@index([noticeId, status], map: "GovernanceNoticeAttachment_notice_status_idx")
  @@index([tenantId, status], map: "GovernanceNoticeAttachment_tenant_status_idx")
  @@index([zoneId, status], map: "GovernanceNoticeAttachment_zone_status_idx")
  @@index([uploadedByUserId, createdAt], map: "GovernanceNoticeAttachment_uploader_created_idx")
  @@index([scanStatus, status], map: "GovernanceNoticeAttachment_scan_status_idx")
  @@index([malwareScanStatus, malwareScanNextAttemptAt], map: "GovernanceNoticeAttachment_malware_dispatch_idx")
  @@index([status, scanStatus, malwareScanStatus], map: "GovernanceNoticeAttachment_security_readiness_idx")
  @@index([createdAt], map: "GovernanceNoticeAttachment_created_idx")
}

/// Successful authenticated attachment access.
/// Rejected/unauthorized attempts remain in the general AuditLog.
model GovernanceOfficialNoticeAttachmentAccess {
  id String @id @default(cuid())

  attachmentId String
  noticeId     String

  /// Present when the access is linked to a resolved notice recipient.
  recipientId String?

  /// Present for authenticated portal access.
  actorUserId String?

  action GovernanceOfficialNoticeAttachmentAccessAction

  ip        String?
  userAgent String?

  metadata Json @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  attachment GovernanceOfficialNoticeAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  notice     GovernanceOfficialNotice           @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  recipient  GovernanceOfficialNoticeRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  actor      User?                              @relation("GovernanceNoticeAttachmentAccessActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([attachmentId, createdAt], map: "GovernanceNoticeAttachmentAccess_attachment_created_idx")
  @@index([noticeId, createdAt], map: "GovernanceNoticeAttachmentAccess_notice_created_idx")
  @@index([recipientId, createdAt], map: "GovernanceNoticeAttachmentAccess_recipient_created_idx")
  @@index([actorUserId, createdAt], map: "GovernanceNoticeAttachmentAccess_actor_created_idx")
}

