}

model FeeInvoice {
  id                 String          @id @default(cuid())
  tenantId           String
  studentId          String
  term               String
  academicYear       String
  totalBilledPesewas Int
  totalWaivedPesewas Int             @default(0)
  note               String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  student            Student         @relation("StudentFeeInvoices", fields: [studentId], references: [id])
  tenant             Tenant          @relation("TenantFeeInvoices", fields: [tenantId], references: [id])
  payments           FeePayment[]    @relation("InvoiceFeePayments")
  adjustments        FeeAdjustment[]
  ledgerEntries      LedgerEntry[]
  receipts           Receipt[]       @relation("InvoiceReceipts")

  @@unique([tenantId, studentId, term, academicYear], name: "FeeInvoice_unique_tenant_student_term_year", map: "FeeInvoice_unique_tenant_student_term_year")
  @@index([tenantId, term, academicYear], map: "FeeInvoice_tenant_term_year_idx")
  @@index([tenantId, studentId], map: "FeeInvoice_tenant_student_idx")
}

/// A payment made against a fee invoice
model FeePayment {
  id            String     @id @default(cuid())
  tenantId      String
  invoiceId     String
  amountPesewas Int
  method        String
  reference     String?
  channel       String?
  paidAt        DateTime   @default(now())
  createdAt     DateTime   @default(now())
  invoice       FeeInvoice @relation("InvoiceFeePayments", fields: [invoiceId], references: [id])
  tenant        Tenant     @relation("TenantFeePayments", fields: [tenantId], references: [id])
  receipt       Receipt?   @relation("PaymentReceipt")

  @@index([tenantId, invoiceId], map: "FeePayment_tenant_invoice_idx")
  @@index([tenantId, paidAt], map: "FeePayment_tenant_paidAt_idx")
}

/// Immutable paper trail for every payment — one Receipt per FeePayment
model Receipt {
  id             String   @id @default(cuid())
  tenantId       String
  invoiceId      String
  feePaymentId   String   @unique
  receiptNumber  String   @unique
  issuedAt       DateTime @default(now()) @db.Timestamptz(6)
  issuedToName   String?
  issuedToPhone  String?
  issuedByUserId String?
  note           String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  tenant        Tenant        @relation("TenantReceipts", fields: [tenantId], references: [id], onDelete: Cascade)
  invoice       FeeInvoice    @relation("InvoiceReceipts", fields: [invoiceId], references: [id], onDelete: Restrict)
  feePayment    FeePayment    @relation("PaymentReceipt", fields: [feePaymentId], references: [id], onDelete: Restrict)
  issuedBy      User?         @relation("ReceiptIssuedBy", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  ledgerEntries LedgerEntry[] @relation("ReceiptLedgerEntries")

  @@index([tenantId, invoiceId])
  @@index([tenantId, issuedAt])
  @@index([tenantId, receiptNumber])
}

