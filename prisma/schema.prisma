  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdBy User   @relation(fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "InviteCode_createdBy_fkey")

  uses InviteCodeUse[]

  @@index([tenantId, expiresAt], map: "InviteCode_tenant_expires_idx")
  @@index([tenantId, roleId], map: "InviteCode_tenant_role_idx")
  @@index([tenantId, revokedAt], map: "InviteCode_tenant_revoked_idx")
}

model InviteCodeUse {
  id           String   @id @default(cuid())
  inviteCodeId String
  tenantId     String
  userId       String
  usedAt       DateTime @default(now()) @db.Timestamptz(6)
  ip           String?
  userAgent    String?

  inviteCode InviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Cascade)
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([inviteCodeId, userId], map: "InviteCodeUse_invite_user_unique")
  @@index([tenantId, usedAt], map: "InviteCodeUse_tenant_usedAt_idx")
}

/// *
/// * =======================
/// * Sprint 10 — GES Zone Hierarchy & AI Analytics
/// * =======================

// Flexible country-agnostic zone type (Circuit, District, Region, LGA, etc.)
model AdminZoneType {
  id          String      @id @default(cuid())
  countryCode String // "GH", "NG", "KE" etc.
  level       Int // 1=lowest (circuit), 2=district, 3=region, 4=national
  name        String // "Circuit", "District", "Region", "LGA", "County" etc.
  zones       AdminZone[]

  @@unique([countryCode, level], map: "AdminZoneType_country_level_unique")
  @@index([countryCode])
}

model AdminZone {
  id           String        @id @default(cuid())
  name         String
  code         String?
  zoneTypeId   String
  zoneType     AdminZoneType @relation(fields: [zoneTypeId], references: [id])
  parentZoneId String?
  parentZone   AdminZone?    @relation("ZoneHierarchy", fields: [parentZoneId], references: [id])
  childZones   AdminZone[]   @relation("ZoneHierarchy")
  tenants      Tenant[]
  officers     GesOfficer[]

  @@index([zoneTypeId])
  @@index([parentZoneId])
}

model GesOfficer {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id])
  zoneId     String
  zone       AdminZone @relation(fields: [zoneId], references: [id])
  title      String // "SISO", "District Director", "Regional Director", "Director-General"
  phone      String?
  notifMuted Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([zoneId])
}

// Daily AI briefing snapshots — one per tenant per day
model SchoolRiskSnapshot {
  id                    String   @id @default(cuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  snapshotDate          DateTime @db.Date
  attendanceRate        Float
  assessmentAvg         Float
  lessonNoteRate        Float
  healthFlagCount       Int
  riskScore             Int // 0-100, higher = more at risk
  riskLevel             String   @default("LOW") // LOW | MEDIUM | HIGH | CRITICAL
  becePassRatePredicted Float? // null if no JHS3 (BS11) students
  alerts                Json     @default("[]")
  createdAt             DateTime @default(now())

  @@unique([tenantId, snapshotDate], map: "SchoolRiskSnapshot_tenant_date_unique")
  @@index([tenantId, snapshotDate])
}

