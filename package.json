{
  "name": "ayitikope-mis",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbo",
    "lfs:pull": "git lfs install --local && git lfs pull --include=\"public/**\"",
    "lfs:pull:optional": "node scripts/lfs-pull-optional.mjs",
    "build": "npm run lfs:pull:optional && prisma generate && next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "finance:qa": "node scripts/finance-sprint9-qa-gate.mjs",
    "finance:cron:hosted": "node scripts/run-hosted-finance-cron.mjs",
    "postinstall": "node scripts/prisma-postinstall.mjs",
    "seed": "node prisma/seed.cjs",
    "seed:ts": "ts-node --project tsconfig.seed.json prisma/seed.ts"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@node-rs/argon2": "^2.0.0",
    "@prisma/client": "^6.19.1",
    "@sparticuz/chromium": "^147.0.2",
    "@supabase/supabase-js": "^2.76.1",
    "@zxing/browser": "^0.2.0",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.38.0",
    "next": "^15.5.9",
    "next-auth": "^4.24.13",
    "otplib": "^12.0.1",
    "pdfkit": "^0.18.0",
    "puppeteer-core": "^24.29.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@tailwindcss/postcss": "^4.1.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.25",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.9",
    "postcss": "^8.5.6",
    "prisma": "^6.19.1",
    "tailwindcss": "^4.1.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "diff": "4.0.4"
  }
}
