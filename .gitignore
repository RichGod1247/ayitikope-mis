# --- Dependencies / package managers ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Build / output ---
.next/
out/
dist/
build/

# --- Coverage / testing ---
coverage/

# --- Logs / debug ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Env & secrets (DO NOT COMMIT REAL SECRETS) ---
# Ignore real env files, but keep example templates
.env
.env.*
!.env.example
!*.env.example
# Prisma env handling
prisma/.env
!prisma/.env.example
# Common backup patterns
*.env.bak
*.env.back*
*.env.backup_*

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/

# --- Vercel / hosting ---
.vercel/

# --- TypeScript artifacts ---
*.tsbuildinfo
next-env.d.ts

# --- Generated code you don’t want in Git ---
/generated/prisma
